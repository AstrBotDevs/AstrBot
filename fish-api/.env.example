FISH_ENV=development
FISH_DATABASE_URL=sqlite:///./data/fish.db
FISH_JWT_SECRET=change-me-to-a-long-random-string
FISH_JWT_EXPIRE_MINUTES=10080
FISH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 实际 APIKEY 额度系数：支付宝付 100 元 → 钱包进 100 * 0.5 = 50（可按热度调整）
FISH_TOPUP_CREDIT_RATIO=0.5
FISH_MIN_TOPUP_YUAN=1
# 添饭三档：_1/_2/_3 = 档位序号；YUAN = 标价（元）
FISH_FEED_PLAN_YUAN_1=2
FISH_FEED_PLAN_YUAN_2=5
FISH_FEED_PLAN_YUAN_3=20
FISH_FEED_PLAN_NAME_1=唔饿啦
FISH_FEED_PLAN_NAME_2=贴贴罐
FISH_FEED_PLAN_NAME_3=饱饱桶
# 白饭：用户侧 1 支付宝实付元 = 500g（库内仍按 TOPUP_CREDIT_RATIO 记内部元）
FISH_RICE_GRAMS_PER_YUAN=500
# 用量展示倍数：用户看到的白饭消耗 = 内部估算 × 此倍数（不向前端暴露）
FISH_USAGE_DISPLAY_MULTIPLIER=2
# 每百万 token 对应的内部 APIKEY 元（占位，后续可接真实模型成本）
FISH_INTERNAL_YUAN_PER_MILLION_TOKENS=1
# AstrBot 主库只读（示例：仓库根 data/data_v4.db 的绝对路径）
# FISH_ASTRBOT_DATABASE_URL=sqlite:////path/to/AstrBot/data/data_v4.db
# 支付宝收款码图片 URL（可放图床，或 fish-console/public/alipay-qr.png 走前端静态）
FISH_ALIPAY_QR_URL=
FISH_ALIPAY_PAY_HINT=转账金额须与本次添饭一致，备注请原样填写下方备注码。
# 鱼咖管理员邮箱（逗号分隔）；登录 fish-console 后进「鱼咖收银台」
FISH_ADMIN_EMAILS=you@example.com
# 脚本/API 备用：curl -X POST .../orders/{id}/confirm -H "X-Fish-Admin-Key: xxx"
FISH_ADMIN_API_KEY=
# 仅本地调试可 true；生产务必 false，改用手动 confirm
FISH_AUTO_CONFIRM_ORDERS=false
