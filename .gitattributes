# Normalize every text file to LF in both the repository and working tree.
# Binary assets remain exempt from line-ending conversion below.
* text=auto eol=lf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.wav   binary
*.svg   binary

# Vendored Archify renderer
.agents/skills/archify/** linguist-vendored
.agents/skills/archify/SKILL.md linguist-vendored=false
.agents/skills/archify/REFERENCE.md linguist-vendored=false
.agents/skills/archify/VENDOR.json linguist-vendored=false
.agents/skills/archify/scripts/check-checkout.mjs linguist-vendored=false
