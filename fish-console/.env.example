VITE_BRAND_NAME=大肥鱼鱼咖
# 可选：外链教程地址；留空则侧栏不显示「使用文档」
# VITE_DOCS_URL=
VITE_SUPPORT_EMAIL=support@example.com
# fish-api 未启动时的兜底（线上以 API 为准；到账系数仅服务端 FISH_TOPUP_CREDIT_RATIO）
VITE_MIN_TOPUP_YUAN=1
# 三档饭量：_1/_2/_3 = 档位序号；YUAN = 标价（元）
VITE_FEED_PLAN_YUAN_1=2
VITE_FEED_PLAN_YUAN_2=5
VITE_FEED_PLAN_YUAN_3=10
VITE_FEED_PLAN_NAME_1=唔饿啦
VITE_FEED_PLAN_NAME_2=贴贴罐
VITE_FEED_PLAN_NAME_3=饱饱桶
# 支付宝收款码（放 public/；默认 /收款码.jpg 或 alipay-qr.png）
# VITE_ALIPAY_QR_URL=/收款码.jpg
