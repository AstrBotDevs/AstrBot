# syntax=docker/dockerfile:1.7
FROM node:26.5.0-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66 AS builder

WORKDIR /src

# hadolint ignore=DL3018
RUN apk add --no-cache git \
    && npm install --global npm@12.0.2 pnpm@11.21.0

COPY docs/package.json docs/pnpm-lock.yaml ./

RUN --mount=type=cache,target=/pnpm/store,sharing=locked \
    pnpm fetch --frozen-lockfile

COPY docs/ ./

RUN --mount=type=cache,target=/pnpm/store,sharing=locked \
    CI=true pnpm install --frozen-lockfile --offline \
    && pnpm run docs:build

FROM nginxinc/nginx-unprivileged:1.29.8-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6

COPY docs/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /src/.vitepress/dist/ /usr/share/nginx/html/

EXPOSE 8080
